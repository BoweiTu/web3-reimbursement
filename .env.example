# ============================================
# Web3 报销系统 - 环境变量配置
# ============================================
# 使用前请复制本文件为 .env 并填入真实值：
#   cp .env.example .env

# 部署私钥（从 MetaMask 等钱包导出）
# 警告：切勿将含真实私钥的 .env 提交到 Git！
# 部署合约需要此私钥对应的账户有足够的测试币
PRIVATE_KEY=your_private_key_here

# Monad 测试网 RPC URL（默认值已内置，通常无需修改）
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
